# Скопировать в .env (chmod 600). Файл .env в git не класть.

# ключ, которым LibreChat обращается к LiteLLM на ВМ: openssl rand -hex 24, с префиксом sk-
LITELLM_MASTER_KEY=sk-<сгенерировать>

# удалённый LiteLLM (наш контур, Qwen) — выдают владельцы LiteLLM
REMOTE_LITELLM_BASE=https://<удалённый-litellm>/v1
REMOTE_LITELLM_KEY=<ключ>

# что маскировать (полный список: + LOCATION, ORGANIZATION, RU_INN_ORG)
MASK_ENTITIES=PERSON,RU_INN_PERSON,RU_SNILS,RU_PASSPORT,PHONE_NUMBER,EMAIL_ADDRESS,RU_BANK_ACCOUNT,CREDIT_CARD
